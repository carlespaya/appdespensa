{
  "expo": {
    "name": "Despensa",
    "slug": "appdespensa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.despensa.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#060A14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.despensa.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Despensa usa la cámara para escanear tus tickets de compra.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Despensa usa tu ubicación para calcular qué supermercados te quedan más cerca."
        }
      ]
    ],
    "scheme": "despensa",
    "backgroundColor": "#060A14",
    "experiments": {
      "typedRoutes": true
    }
  }
}
